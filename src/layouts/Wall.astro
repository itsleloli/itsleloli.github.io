---
import '@fontsource-variable/bricolage-grotesque/standard.css';
import '../styles/global.css';
import Links from '../components/Links.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const isHome = Astro.url.pathname === base;
const link = (hash: string) => (isHome ? hash : `${base}${hash}`);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta name="theme-color" content="#f6f7f9" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
      <div class="wrap top-in">
        <a class="name" href={base}>
          <span class="name-note" aria-hidden="true"></span>
          Leandro Bonora
        </a>
        <nav aria-label="Main">
          <ul>
            <li><a href={link('#work')}>Work</a></li>
            <li><a href={link('#about')}>About</a></li>
            <li><a href={link('#cv')}>CV</a></li>
          </ul>
        </nav>
        <a class="cta top-cta" href={link('#contact')}>Let’s talk</a>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap foot-in">
        <p>© 2026 Leandro Rosero Bonora</p>
        <p>No sticky notes were wasted making this site. Okay, a few.</p>
      </div>
    </footer>
    <Links />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 12px;
    top: -60px;
    z-index: 30;
    padding: 10px 14px;
    background: var(--ink);
    color: var(--wall);
    text-decoration: none;
  }

  .skip:focus {
    top: 12px;
  }

  .top {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--wall);
  }

  .top-in {
    display: flex;
    align-items: center;
    gap: clamp(16px, 3vw, 40px);
    min-height: 72px;
  }

  .name {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    text-decoration: none;
    font-weight: 800;
    font-size: var(--fs-body);
    letter-spacing: -0.02em;
  }

  .name-note {
    width: 18px;
    height: 18px;
    background: var(--yellow);
    box-shadow: var(--note-shadow);
    transform: rotate(-6deg);
  }

  nav {
    margin-left: auto;
  }

  nav ul {
    display: flex;
    gap: clamp(16px, 2.5vw, 32px);
    list-style: none;
  }

  nav a {
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
  }

  nav a:hover {
    text-decoration: underline;
    text-decoration-color: var(--orange);
    text-decoration-thickness: 3px;
    text-decoration-skip-ink: none;
  }

  .top-cta {
    min-height: 42px;
    padding: 8px 16px;
    font-size: var(--fs-small);
  }

  @media (max-width: 640px) {
    nav {
      display: none;
    }

    .top-cta {
      margin-left: auto;
    }
  }

  .foot {
    padding-block: 40px 56px;
    color: var(--ink-2);
    font-size: var(--fs-small);
  }

  .foot-in {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
  }
</style>
