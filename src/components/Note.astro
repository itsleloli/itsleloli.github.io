---
// A sticky note. Colour carries a fixed role: yellow people, orange what happens,
// blue what the system does, pink the problem (or the call to action).
export type NoteColor = 'yellow' | 'orange' | 'blue' | 'pink' | 'ghost';

interface Props {
  color: NoteColor;
  tilt?: number;
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  /** Defaults to true for plain notes, false for link notes. */
  drag?: boolean;
  /** Leave this note out of the live arrows (e.g. the call-to-action note). */
  linkSkip?: boolean;
}

const { color, tilt = 0, size = 'md', href, linkSkip = false } = Astro.props;
// Every plain note can be picked up and moved; link notes stay put so a drag never fights a click.
const drag = Astro.props.drag ?? !href;
const Tag = href ? 'a' : 'div';
---

<Tag
  class:list={['note', `note-${color}`, `note-${size}`]}
  style={`--tilt: ${tilt}deg`}
  href={href}
  data-drag={drag ? '' : undefined}
  data-link-skip={linkSkip ? '' : undefined}
>
  <slot />
</Tag>

<script>
  // Drag notes around the wall (desktop only). They settle with a fresh tilt where dropped,
  // and tell their [data-links] container so the marker arrows follow.
  const phone = window.matchMedia('(max-width: 700px)');
  for (const note of document.querySelectorAll<HTMLElement>('[data-drag]')) {
    const links = note.closest<HTMLElement>('[data-links]');
    const moved = () => links?.dispatchEvent(new Event('notes:moved'));
    let startX = 0;
    let startY = 0;
    let dx = 0;
    let dy = 0;

    note.addEventListener('pointerdown', (e) => {
      // Phones: a swipe must scroll the page, not drag a note.
      if (phone.matches) return;
      note.setPointerCapture(e.pointerId);
      note.classList.add('is-held');
      startX = e.clientX - dx;
      startY = e.clientY - dy;
    });

    note.addEventListener('pointermove', (e) => {
      if (!note.hasPointerCapture(e.pointerId)) return;
      dx = e.clientX - startX;
      dy = e.clientY - startY;
      note.style.setProperty('--dx', `${dx}px`);
      note.style.setProperty('--dy', `${dy}px`);
      moved();
    });

    const drop = (e: PointerEvent) => {
      if (note.hasPointerCapture(e.pointerId)) note.releasePointerCapture(e.pointerId);
      note.classList.remove('is-held');
      note.style.setProperty('--tilt', `${(Math.random() * 6 - 3).toFixed(1)}deg`);
      moved();
    };
    note.addEventListener('transitionend', moved);
    note.addEventListener('pointerup', drop);
    note.addEventListener('pointercancel', drop);
  }
</script>

<style>
  .note {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 10px;
    aspect-ratio: 1;
    padding: 18px 18px 16px;
    color: var(--ink);
    text-decoration: none;
    font-weight: 700;
    line-height: 1.18;
    letter-spacing: -0.01em;
    box-shadow: var(--note-shadow);
    transform: translate(var(--dx, 0px), var(--dy, 0px)) rotate(var(--tilt));
    transition:
      transform 360ms var(--ease),
      box-shadow 360ms var(--ease);
  }

  .note-sm {
    width: clamp(140px, 15vw, 176px);
    font-size: var(--fs-small);
  }

  .note-md {
    width: clamp(168px, 19vw, 232px);
    font-size: var(--fs-note);
    line-height: 1.12;
  }

  .note-lg {
    width: clamp(220px, 28vw, 340px);
    font-size: var(--fs-title);
    padding: 26px;
  }

  .note-yellow {
    background: var(--yellow);
  }

  .note-orange {
    background: var(--orange);
  }

  .note-blue {
    background: var(--blue);
  }

  .note-pink {
    background: var(--pink);
  }

  /* A note that isn't stuck on the wall yet: what comes next. */
  .note-ghost {
    background: transparent;
    border: 2.5px dashed var(--ink);
    box-shadow: none;
  }

  a.note:hover {
    --tilt: 0deg;
    box-shadow: var(--note-shadow-up);
  }

  [data-drag] {
    cursor: grab;
    touch-action: none;
    user-select: none;
  }

  @media (max-width: 700px) {
    [data-drag] {
      cursor: default;
      touch-action: auto;
      user-select: auto;
    }
  }

  [data-drag].is-held {
    cursor: grabbing;
    z-index: 5;
    box-shadow: var(--note-shadow-up);
    transition: box-shadow 200ms var(--ease);
  }

  /* Phones: notes fill a two-column grid instead of fixed sizes. */
  @media (max-width: 700px) {
    .note-sm,
    .note-md {
      width: 100%;
      padding: 14px 14px 12px;
      font-size: var(--fs-small);
      line-height: 1.18;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .note {
      transition: none;
    }
  }
</style>
