---
import '@fontsource-variable/caveat';
// A sticky note. Colour carries a fixed role: yellow people, orange what happens,
// blue what the system does, pink the problem (or the call to action).
export type NoteColor = 'yellow' | 'orange' | 'blue' | 'pink' | 'ghost';

interface Props {
  color: NoteColor;
  tilt?: number;
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  /** Defaults to true for plain notes, false for link notes. */
  drag?: boolean;
  /** Leave this note out of the live arrows (e.g. the call-to-action note). */
  linkSkip?: boolean;
}

const { color, tilt = 0, size = 'md', href, linkSkip = false } = Astro.props;
// An easter egg: a line written on the wall behind the note, only seen once it's dragged away.
// Rendered first: a slot filled with `{cond && ...}` still "has" content even when it's empty.
const egg = Astro.slots.has('egg') ? (await Astro.slots.render('egg')).trim() : '';
const hasEgg = egg !== '';
const Spot = hasEgg ? 'div' : Fragment;
// Every plain note can be picked up and moved; link notes stay put so a drag never fights a click.
const drag = Astro.props.drag ?? !href;
const Tag = href ? 'a' : 'div';
---

<Spot {...(hasEgg ? { class: 'egg-spot' } : {})}>
{hasEgg && <span class="egg" aria-hidden="true" set:html={egg} />}
<Tag
  class:list={['note', `note-${color}`, `note-${size}`]}
  style={`--tilt: ${tilt}deg`}
  href={href}
  data-drag={drag ? '' : undefined}
  data-link-skip={linkSkip ? '' : undefined}
>
  <slot />
</Tag>
</Spot>

<script>
  // Drag notes around the wall (desktop only). They settle with a fresh tilt where dropped,
  // and tell their [data-links] container so the marker arrows follow.
  // Touch screens and phones never drag: a swipe must always scroll.
  const phone = window.matchMedia('(max-width: 700px), (pointer: coarse)');
  // On touch screens and phones notes don't react at all: no drag code is attached.
  for (const note of phone.matches ? [] : document.querySelectorAll<HTMLElement>('[data-drag]')) {
    const links = note.closest<HTMLElement>('[data-links]');
    const moved = () => links?.dispatchEvent(new Event('notes:moved'));
    let startX = 0;
    let startY = 0;
    let dx = 0;
    let dy = 0;
    const tilt = note.style.getPropertyValue('--tilt');

    // "Put the notes back" in the corner sends every note home, with its own tilt.
    document.addEventListener('notes:reset', () => {
      dx = 0;
      dy = 0;
      note.style.removeProperty('--dx');
      note.style.removeProperty('--dy');
      note.style.setProperty('--tilt', tilt);
      moved();
    });

    note.addEventListener('pointerdown', (e) => {
      note.setPointerCapture(e.pointerId);
      note.classList.add('is-held');
      startX = e.clientX - dx;
      startY = e.clientY - dy;
    });

    note.addEventListener('pointermove', (e) => {
      if (!note.hasPointerCapture(e.pointerId)) return;
      dx = e.clientX - startX;
      dy = e.clientY - startY;
      note.style.setProperty('--dx', `${dx}px`);
      note.style.setProperty('--dy', `${dy}px`);
      moved();
    });

    const drop = (e: PointerEvent) => {
      // Only a note that was actually picked up gets a new tilt; a tap on a phone leaves it alone.
      if (!note.hasPointerCapture(e.pointerId)) return;
      note.releasePointerCapture(e.pointerId);
      note.classList.remove('is-held');
      note.style.setProperty('--tilt', `${(Math.random() * 6 - 3).toFixed(1)}deg`);
      moved();
    };
    note.addEventListener('transitionend', moved);
    note.addEventListener('pointerup', drop);
    note.addEventListener('pointercancel', drop);
  }
</script>

<style>
  /* The egg sits in the note's spot; the note (later in the DOM) paints over it. */
  .egg-spot {
    position: relative;
    display: grid;
  }

  .egg {
    position: absolute;
    inset: 16px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 6px;
    /* Written on the wall in marker: the only handwriting on the site. */
    color: #1838a8; /* a shade darker than the link blue, for contrast on the wall */
    font-family: 'Caveat Variable', 'Caveat', cursive;
    font-size: 1.32rem;
    font-weight: 500;
    line-height: 1.15;
    text-align: center;
    text-wrap: balance;
    transform: rotate(-2deg);
  }

  /* Phones can't drag notes, so there's nothing to find there. */
  @media (max-width: 700px), (pointer: coarse) {
    .egg {
      display: none;
    }
  }

  .note {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 10px;
    aspect-ratio: 1;
    padding: 18px 18px 16px;
    color: var(--ink);
    text-decoration: none;
    font-weight: 700;
    line-height: 1.18;
    letter-spacing: -0.01em;
    text-wrap: balance;
    box-shadow: var(--note-shadow);
    transform: translate(var(--dx, 0px), var(--dy, 0px)) rotate(var(--tilt));
    transition:
      transform 360ms var(--ease),
      box-shadow 360ms var(--ease);
  }

  .note-sm {
    width: clamp(140px, 15vw, 176px);
    font-size: var(--fs-small);
  }

  .note-md {
    width: clamp(168px, 19vw, 232px);
    font-size: var(--fs-note);
    line-height: 1.12;
  }

  .note-lg {
    width: clamp(220px, 28vw, 340px);
    font-size: var(--fs-title);
    padding: 26px;
  }

  .note-yellow {
    background: var(--yellow);
  }

  .note-orange {
    background: var(--orange);
  }

  .note-blue {
    background: var(--blue);
  }

  .note-pink {
    background: var(--pink);
  }

  /* A note that isn't stuck on the wall yet: what comes next. */
  .note-ghost {
    background: transparent;
    border: 2.5px dashed var(--ink);
    box-shadow: none;
  }

  a.note:hover {
    --tilt: 0deg;
    box-shadow: var(--note-shadow-up);
  }

  [data-drag] {
    cursor: grab;
    touch-action: none;
    user-select: none;
  }

  @media (max-width: 700px), (pointer: coarse) {
    [data-drag] {
      cursor: default;
      touch-action: auto;
      user-select: auto;
      pointer-events: none;
      -webkit-tap-highlight-color: transparent;
    }
  }

  [data-drag].is-held {
    cursor: grabbing;
    z-index: 5;
    box-shadow: var(--note-shadow-up);
    transition: box-shadow 200ms var(--ease);
  }

  /* Phones: notes fill a two-column grid instead of fixed sizes. */
  @media (max-width: 700px) {
    .note-sm,
    .note-md {
      width: 100%;
      padding: 14px 14px 12px;
      font-size: var(--fs-small);
      line-height: 1.18;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .note {
      transition: none;
    }
  }
</style>
