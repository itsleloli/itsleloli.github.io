---
// Marker arrows drawn live between the notes inside any [data-links] container:
// from each note's edge to the next one's, redrawn on resize and while a note is dragged.
// Notes marked data-link-skip are left out. Include once per page.
---

<script>
  const NS = 'http://www.w3.org/2000/svg';

  type Box = { x: number; y: number; w: number; h: number };

  // Where the line from this box's centre towards `to` leaves the box, plus a gap.
  const edge = (b: Box, to: { x: number; y: number }, gap: number) => {
    const cx = b.x + b.w / 2;
    const cy = b.y + b.h / 2;
    const dx = to.x - cx;
    const dy = to.y - cy;
    const sx = dx === 0 ? Infinity : (b.w / 2 + gap) / Math.abs(dx);
    const sy = dy === 0 ? Infinity : (b.h / 2 + gap) / Math.abs(dy);
    const s = Math.min(sx, sy);
    return { x: cx + dx * s, y: cy + dy * s };
  };

  const draw = (wall: HTMLElement) => {
    let svg = wall.querySelector<SVGSVGElement>(':scope > svg.links');
    if (!svg) {
      svg = document.createElementNS(NS, 'svg');
      svg.classList.add('links');
      svg.setAttribute('aria-hidden', 'true');
      wall.prepend(svg);
    }
    const origin = wall.getBoundingClientRect();
    const notes = [...wall.querySelectorAll<HTMLElement>('.note:not([data-link-skip])')];
    const boxes: Box[] = notes.map((n) => {
      const r = n.getBoundingClientRect();
      return { x: r.left - origin.left, y: r.top - origin.top, w: r.width, h: r.height };
    });

    let d = '';
    for (let i = 0; i < boxes.length - 1; i++) {
      const a = boxes[i];
      const b = boxes[i + 1];
      const ca = { x: a.x + a.w / 2, y: a.y + a.h / 2 };
      const cb = { x: b.x + b.w / 2, y: b.y + b.h / 2 };
      // Space between the two note edges decides how much breathing room the arrow gets.
      const free = Math.hypot(edge(b, ca, 0).x - edge(a, cb, 0).x, edge(b, ca, 0).y - edge(a, cb, 0).y);
      const p1 = edge(a, cb, Math.min(8, free * 0.12));
      const p2 = edge(b, ca, Math.min(12, free * 0.16));
      const len = Math.hypot(p2.x - p1.x, p2.y - p1.y);
      if (len < 14) continue;
      const head = Math.min(11, len * 0.4);
      // Bow the line slightly upward, like a quick marker stroke.
      let nx = -(p2.y - p1.y) / len;
      let ny = (p2.x - p1.x) / len;
      if (ny > 0) {
        nx = -nx;
        ny = -ny;
      }
      const bow = Math.min(len * 0.22, 36);
      const c = { x: (p1.x + p2.x) / 2 + nx * bow, y: (p1.y + p2.y) / 2 + ny * bow };
      // Arrowhead along the curve's final direction.
      const tl = Math.hypot(p2.x - c.x, p2.y - c.y) || 1;
      const tx = (p2.x - c.x) / tl;
      const ty = (p2.y - c.y) / tl;
      const wing = head * 0.64;
      const h1 = { x: p2.x - tx * head - ty * wing, y: p2.y - ty * head + tx * wing };
      const h2 = { x: p2.x - tx * head + ty * wing, y: p2.y - ty * head - tx * wing };
      d += `M${p1.x} ${p1.y} Q${c.x} ${c.y} ${p2.x} ${p2.y} `;
      d += `M${h1.x} ${h1.y} L${p2.x} ${p2.y} L${h2.x} ${h2.y} `;
    }

    let path = svg.querySelector('path');
    if (!path) {
      path = document.createElementNS(NS, 'path');
      svg.append(path);
    }
    path.setAttribute('d', d);
  };

  const walls = [...document.querySelectorAll<HTMLElement>('[data-links]')];
  const drawAll = () => walls.forEach(draw);

  const ro = new ResizeObserver(drawAll);
  walls.forEach((w) => ro.observe(w));
  window.addEventListener('load', drawAll);
  document.fonts?.ready.then(drawAll);
  for (const w of walls) w.addEventListener('notes:moved', () => draw(w));
  drawAll();
</script>

<style is:global>
  [data-links] {
    position: relative;
  }

  [data-links] > svg.links {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    z-index: 0;
  }

  [data-links] > svg.links path {
    fill: none;
    stroke: var(--ink);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  [data-links] .note {
    z-index: 1;
  }

  /* Phones: notes sit in a 2×2 grid; arrows read it as a Z (1→2, then diagonally 2→3, 3→4). */
  @media (max-width: 700px) {
    [data-links] {
      gap: 36px !important;
    }

    [data-links] > svg.links path {
      stroke-width: 3;
    }
  }
</style>
