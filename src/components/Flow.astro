---
// A short sticky-note flow: the way a workshop wall maps how work moves.
// Arrows between the notes are drawn live by <Links />.
import Note, { type NoteColor } from './Note.astro';

export interface Step {
  color: NoteColor;
  text: string;
}

interface Props {
  steps: Step[];
  label: string;
  size?: 'sm' | 'md';
}

const { steps, label, size = 'sm' } = Astro.props;
const tilts = [-2.5, 1.5, -1, 2, -1.5];
---

<ol class="flow" aria-label={label} data-links>
  {
    steps.map((s, i) => (
      <li>
        <Note color={s.color} tilt={tilts[i % tilts.length]} size={size}>
          {s.text}
        </Note>
      </li>
    ))
  }
</ol>

<style>
  .flow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px clamp(40px, 4.5vw, 64px);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (max-width: 700px) {
    .flow {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }
  }
</style>
