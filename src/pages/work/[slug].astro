---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Wall from '../../layouts/Wall.astro';
import Flow from '../../components/Flow.astro';
import Arrow from '../../components/Arrow.astro';
import MigrationMap from '../../components/MigrationMap.astro';

export async function getStaticPaths() {
  return (await getCollection('work')).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'work'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Wall title={`${d.title} · Leandro Bonora`} description={d.summary}>
  <article>
    <header class="wrap case-head">
      <p class="back"><a href={`${base}#work`}><Arrow dir="left" /> All work</a></p>
      <h1 class="case-title">{d.title}</h1>
      <p class="case-summary">{d.summary}</p>
      <p class="case-meta">{d.role} · {d.period} · {d.status}</p>
    </header>

    <div class="wrap case-flow">
      <Flow steps={d.flow} label="How it works" size="md" />
    </div>

    <div class="wrap case-body">
      <div class="prose">
        <Content />
      </div>
      <aside class="stack" aria-label="System and stack">
        <MigrationMap />
        <p class="stack-head">Built with</p>
        <p>{d.stack.join(', ')}</p>
        <p class="stack-note">At a Dutch meal-kit company. Details kept anonymous.</p>
      </aside>
    </div>

    <nav class="wrap case-next" aria-label="Next">
      <a href="mailto:bonoraleandro@gmail.com">
        <span class="next-title">
          Got a project in mind? Email me <Arrow />
        </span>
      </a>
    </nav>
  </article>
</Wall>

<style>
  .case-head {
    padding-block: clamp(32px, 6vw, 80px) clamp(28px, 4vw, 48px);
  }

  .back {
    font-weight: 650;
    margin-bottom: clamp(24px, 4vw, 48px);
  }

  .back a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .case-title {
    font-size: var(--fs-display);
    line-height: 0.98;
    letter-spacing: -0.035em;
    max-width: 18ch;
  }

  .case-summary {
    margin-top: 22px;
    max-width: 48ch;
    font-size: var(--fs-lede);
    line-height: 1.4;
    color: var(--ink-2);
  }

  .case-meta {
    margin-top: 14px;
    font-size: var(--fs-small);
    color: var(--ink-2);
  }

  .case-flow {
    padding-block: clamp(24px, 4vw, 48px) clamp(56px, 8vw, 104px);
  }

  .case-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 380px);
    gap: clamp(40px, 7vw, 104px);
    align-items: start;
  }

  .prose {
    max-width: 64ch;
    font-size: var(--fs-body);
    line-height: 1.65;
  }

  .prose :global(h2) {
    font-size: var(--fs-subtitle);
    letter-spacing: -0.025em;
    margin: clamp(48px, 6vw, 72px) 0 14px;
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(ul) {
    list-style: none;
    display: grid;
    gap: 12px;
  }

  .prose :global(li) {
    position: relative;
    padding-left: 30px;
  }

  .prose :global(li)::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 10px;
    height: 10px;
    background: var(--ink);
    transform: rotate(-4deg);
  }

  .prose :global(strong) {
    font-weight: 750;
  }

  .stack {
    position: sticky;
    top: 104px;
    display: grid;
    gap: 6px;
    font-size: var(--fs-small);
  }

  .stack-head {
    margin-top: 28px;
    font-weight: 750;
  }

  .stack-note {
    margin-top: 10px;
    color: var(--ink-2);
    font-size: var(--fs-small);
  }

  .case-next {
    padding-block: var(--step);
  }

  .case-next a {
    display: inline-grid;
    gap: 6px;
    color: var(--ink);
    text-decoration: none;
  }


  .next-title {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: var(--fs-title);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.05;
    text-decoration: underline;
    text-decoration-skip-ink: none;
    text-decoration-color: var(--orange);
    text-decoration-thickness: 4px;
    text-underline-offset: 0.16em;
  }

  .case-next a:hover .next-title {
    text-decoration-color: var(--ink);
  }

  @media (max-width: 860px) {
    .case-body {
      grid-template-columns: 1fr;
    }

    .stack {
      order: -1;
      max-width: 420px;
      position: static;
    }
  }
</style>
